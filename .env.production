# Production origin. NEXT_PUBLIC_SITE_URL is inlined into the bundle at BUILD
# time by Next.js, so it must be present when `next build` runs — a deploy-time
# env var alone is too late. Committed deliberately: this is a public domain,
# not a secret. (The generic `.env*` gitignore rule is bypassed for this file
# via `git add -f`, because it must be reproducible across every deploy.)
#
# Promotion history: was `https://aihub.invalid` (placeholder) until the real
# domain ai-hubs.tech was confirmed. See scripts/verify-launch.ts, which fails
# the launch if this is ever the placeholder again.
NEXT_PUBLIC_SITE_URL=https://ai-hubs.tech
